# AML Workbench Backend - Environment Configuration Template
# Copy this file to .env and customize for your environment

# === Database Configuration ===
# SQLite for local development (default)
DATABASE_URL=sqlite:///./app.db

# PostgreSQL for production (uncomment and configure)
# DATABASE_URL=postgresql://username:password@localhost:5432/aml_workbench

# === Security Configuration ===
# REQUIRED - Must be at least 32 characters for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-minimum-32-characters-required-for-production

# === JWT Configuration ===
# Algorithm for JWT token signing (HS256 recommended)
JWT_ALGORITHM=HS256

# JWT token expiry in minutes (default: 480 = 8 hours)
JWT_EXPIRY_MINUTES=480

# === CORS Configuration ===
# Comma-separated list of allowed origins (no spaces)
# Include all frontend URLs that will access this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Feature Flags ===
# Enable rate limiting on authentication endpoints
RATE_LIMIT_ENABLED=true

# Enable debug mode (set to false in production)
DEBUG=false
