# Backend Environment Variables

# Database connection string
# Local development (SQLite): sqlite:///./app.db
# Production (PostgreSQL): postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./app.db

# JWT Authentication
# Generate a secure random key for production: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# CORS origins (comma-separated list for multiple origins)
# Local development: http://localhost:5173
# Production: https://your-domain.com
CORS_ORIGINS=http://localhost:5173

# Debug mode (enable detailed error messages and logging)
# Set to "false" in production
DEBUG=true

# Rate limiting (protect auth endpoints from brute force)
# Set to "true" in production
RATE_LIMIT_ENABLED=true
